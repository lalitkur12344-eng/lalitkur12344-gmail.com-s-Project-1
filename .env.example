# ==========================================
# REC Bijnor Campus Care - Environment Config
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# JWT Authentication Secret (Required for production tokens)
JWT_SECRET=rec_bijnor_campus_care_super_secure_jwt_secret_2026_xyz

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_care?retryWrites=true&w=majority

# AI Integration (Gemini Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Approved Frontend Origin(s) for CORS (comma separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Email Notification Configuration (Nodemailer SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=campuscare@recb.ac.in
SMTP_PASS=your_email_app_password
EMAIL_FROM=REC Bijnor Campus Care <campuscare@recb.ac.in>

# ==========================================
# SMS Notification Configuration (Twilio Provider Adapter)
# ==========================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# Notification Queue & Worker Configuration
# ==========================================
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_WORKER_CONCURRENCY=5
