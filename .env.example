# ==============================================================================
# Rajkiya Engineering College, Bijnor (REC Bijnor)
# Campus Care Management System — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root (alongside package.json & server.ts).
# 2. Fill in your actual credentials.
# 3. Never commit '.env' to version control (it is ignored by .gitignore).
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# JSON Web Token Secret (Use a strong, cryptographically random secret)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Persistent Database (MongoDB Atlas URI or local MongoDB instance)
# Note: MongoDB persistence is strictly required. No in-memory or JSON file substitutes.
MONGODB_URI=mongodb://127.0.0.1:27017/campus_care

# AI Triage & Help Engine (Google Gemini 3.8 Flash)
GEMINI_API_KEY=

# ==============================================================================
# Email Notification Configuration (Gmail SMTP with STARTTLS)
# ==============================================================================
# Instructions for Gmail SMTP:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Set SMTP_USER to your full Gmail address (e.g., student.affairs@recb.ac.in or your-gmail@gmail.com).
# 4. Set SMTP_PASS to the 16-character App Password (WITHOUT spaces).
# 5. Never use your regular Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASS=YOUR_GOOGLE_APP_PASSWORD
EMAIL_FROM="REC Bijnor Campus Care <YOUR_GMAIL_ADDRESS@gmail.com>"

# ==============================================================================
# SMS Notification Gateway (Twilio Provider Adapter)
# ==============================================================================
# Instructions for Twilio SMS:
# 1. Sign up or log in at https://console.twilio.com/
# 2. Retrieve your Account SID and Auth Token from the dashboard.
# 3. Retrieve or purchase an active SMS-capable Twilio phone number (in E.164 format, e.g., +15551234567).
# 4. Note: On Twilio Trial accounts, unverified recipient phone numbers will be rejected by Twilio.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ==============================================================================
# CORS Allowed Origins (Comma-separated list of permitted web origins)
# ==============================================================================
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:5174

# ==============================================================================
# Notification Queue & Background Worker Configuration
# ==============================================================================
NOTIFICATION_QUEUE_ENABLED=true
NOTIFICATION_WORKER_CONCURRENCY=5
